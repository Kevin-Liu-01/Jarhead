<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron needs these three or it will not start under the hardened runtime:
    V8 writes and then executes JIT pages, and Electron dlopens its own
    unsigned-at-build-time helper frameworks.
  -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>

  <!--
    Jarvis shells out to tsx, ffmpeg, screencapture, osascript and cliclick. Under
    the hardened runtime a signed process cannot spawn arbitrary unsigned children
    without this, and every one of those tools is exactly that.
  -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.inherit</key><true/>

  <!-- What Jarvis actually does. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.automation.apple-events</key><true/>
  <key>com.apple.security.network.client</key><true/>

  <!--
    NOT sandboxed, deliberately. App Sandbox would block reading ~/repos, driving
    the accessibility tree of other apps, and synthesizing input — which is most
    of what Jarvis is for. This is a personal app, not a Mac App Store submission.
  -->
</dict>
</plist>

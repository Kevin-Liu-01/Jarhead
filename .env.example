# Jarhead v2 keeps its secrets in ~/.jarhead/env (mode 600), never in the repo and never in a
# .env file. Setup writes that file for you (Console › Settings › Keys, or the wizard); by hand:
#
#   mkdir -p ~/.jarhead && chmod 700 ~/.jarhead
#   cat > ~/.jarhead/env <<'EOF'
#   OPENAI_API_KEY=sk-...            # the voice (GPT-Live-1); billed per second of open session
#   ANTHROPIC_API_KEY=...            # only for the anthropic-api brain
#   JARHEAD_BRAIN_API_KEY=...        # only for an openai-compatible brain server
#   EOF
#   chmod 600 ~/.jarhead/env
#
# The Codex brain needs no key: it uses the ChatGPT login inside Codex Desktop.
# Runtime knobs (optional, also read from ~/.jarhead/env):
#   JARHEAD_AUTO_WAKE=0              # never open a paid session on launch (tests, benches)
#   JARHEAD_INSTALL_HYGIENE=0|fix    # skip / also repair the Dock audit in pnpm build:mac
#   JARHEAD_NO_RELAUNCH=1            # CrashGuard: stay down after a crash
#   JARHEAD_WORKER_SAY=instructions  # worker finish lines through the voice's instructions channel

# Copy to .env.local and fill in. .env.local is gitignored.

# --- Brain -------------------------------------------------------------
# Already exported in Kevin's shell env; jarvisd falls back to process.env.
ANTHROPIC_API_KEY=

# --- Voice out ---------------------------------------------------------
ELEVENLABS_API_KEY=
# Voice id to speak as. Pick one from the ElevenLabs library or clone your own.
ELEVENLABS_VOICE_ID=
# flash v2.5 is the low-latency tier; turbo/multilingual are the alternatives.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Voice in ----------------------------------------------------------
# On-device by default (macOS 26 SpeechAnalyzer / Parakeet). No key needed.
# Set only if you add a cloud STT fallback later.
DEEPGRAM_API_KEY=

# --- kevin-wiki link ---------------------------------------------------
# Absolute path to the live wiki checkout. Jarvis links packages from here
# rather than vendoring copies, so `contracts` can still resolve its schemas
# relative to its own directory.
KEVIN_WIKI_ROOT=/Users/kevinliu/repos/kevin-wiki-rebuild

# --- Runtime -----------------------------------------------------------
JARVIS_STATE_DIR=~/.jarvis
JARVIS_SOCKET=/tmp/jarvisd.sock
JARVIS_LOG_LEVEL=info
